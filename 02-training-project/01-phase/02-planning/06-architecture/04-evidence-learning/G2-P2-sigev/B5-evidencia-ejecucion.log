  ocurrido_en        TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT bitacora_cuenta_fk FOREIGN KEY (cuenta_id) REFERENCES cuentas (id) ON DELETE SET NULL
);
CREATE TABLE
